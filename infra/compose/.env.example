# =============================================================================
# Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control
#
# NOTE: do not put a trailing `# comment` after a value. Docker Compose
# reads this file with `env_file:` and does not strip them, so the comment
# becomes part of the value. Put explanatory text on the line above.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3535

# Loopback port the stack binds to when deployed behind a shared host reverse
# proxy (infra/compose/vps.compose.yml). The proxy forwards to
# 127.0.0.1:<APP_BIND_PORT>; nothing outside the server reaches it directly.
# Must be unique per application when several share one VPS.
# Unused by the dev and prod overlays, which publish 3535 directly.
APP_BIND_PORT=3535

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# External database connection (DATABASE_URL is constructed from these at runtime)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=appdb
POSTGRES_SSL=false

# -----------------------------------------------------------------------------
# JWT / Session
# -----------------------------------------------------------------------------
# IMPORTANT: Generate a strong secret for production (min 32 characters)
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-key-min-32-characters-long
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14
COOKIE_SECRET=your-cookie-secret-key-min-32-characters-long

# -----------------------------------------------------------------------------
# Credential Encryption
# -----------------------------------------------------------------------------
# Encrypts secrets an administrator configures at runtime through the app
# (e.g. an SMTP password) before they are stored in the database. This is
# separate from the deploy-time secrets above (JWT_SECRET, GOOGLE_CLIENT_SECRET,
# etc.), which are unaffected by this variable and are not encrypted with it.
#
# Optional until a credential is actually stored: if unset, the app boots
# normally with a warning and only fails when something tries to save a
# credential. It becomes mandatory (boot fails) the moment any encrypted
# credential exists in the database and this key is missing or wrong.
# See: docs/runbooks/rotate-secrets-encryption-key.md
#
# As of epic #20 it also protects the platform OpenAI key and every user's own
# key, so any deployment running AI features must set it.
#
# IMPORTANT: Generate a strong key for production
# Example: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# OAuth - Google (Required)
# -----------------------------------------------------------------------------
# Get credentials from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3535/api/auth/google/callback

# -----------------------------------------------------------------------------
# OAuth - Microsoft (Optional)
# -----------------------------------------------------------------------------
# Get credentials from: https://portal.azure.com
# MICROSOFT_CLIENT_ID=your-microsoft-client-id
# MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
# MICROSOFT_CALLBACK_URL=http://localhost:3535/api/auth/microsoft/callback

# -----------------------------------------------------------------------------
# Initial Admin Bootstrap
# -----------------------------------------------------------------------------
# First user to log in with this email will be assigned Admin role
INITIAL_ADMIN_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# Test Authentication (Development/Test Only)
# -----------------------------------------------------------------------------
# Test auth is automatically enabled when NODE_ENV !== 'production'
# This provides /api/auth/test/login endpoint and /testing/login page
# for Playwright E2E testing without requiring real OAuth credentials.
#
# Set to 'false' to explicitly disable test auth in development:
# TEST_AUTH_ENABLED=false
#
# WARNING: Setting TEST_AUTH_ENABLED=true in production will cause the app
# to fail at startup as a safety measure.

# -----------------------------------------------------------------------------
# Device Authorization Flow (RFC 8628)
# -----------------------------------------------------------------------------
# Configuration for device authorization (CLI, Swagger UI, mobile apps)
DEVICE_CODE_EXPIRY_MINUTES=15
DEVICE_CODE_POLL_INTERVAL=5
# Lifetime of access and refresh tokens issued by the device flow (default: 7 days)
DEVICE_TOKEN_EXPIRY_DAYS=7
# Lifetime of the personal access token minted when a device requests
# clientInfo.tokenType: "pat" (how the CLI logs in). Longer than the session
# credential above because a PAT is revocable server-side from the Access
# Tokens page, while the JWT above cannot be revoked before it expires.
# Values outside 1-999 are rejected and fall back to the default (default: 90 days)
DEVICE_PAT_EXPIRY_DAYS=90

# -----------------------------------------------------------------------------
# Observability (OpenTelemetry)
# -----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=evolvepath-api
LOG_LEVEL=info
# Uncomment to enable OTEL diagnostic logging (development only)
# OTEL_DEBUG=true

# -----------------------------------------------------------------------------
# Uptrace (when using docker-compose.otel.yml)
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Uptrace credentials
# -----------------------------------------------------------------------------
# These were previously hardcoded in infra/otel/uptrace.yml and
# infra/otel/otel-collector-config.yaml. They are development defaults only —
# CHANGE THEM before exposing the observability stack anywhere non-local.
UPTRACE_PROJECT1_TOKEN=project1_secret_token
UPTRACE_SECRET_KEY=change-me-in-production-1234567890abcdef
UPTRACE_ADMIN_EMAIL=admin@localhost
UPTRACE_ADMIN_PASSWORD=admin
UPTRACE_PGPASSWORD=uptrace
# Where the Uptrace UI is reached. 2.x uses this for dashboard links and CORS.
UPTRACE_SITE_URL=http://localhost:14318
# Optional. Uptrace 2.x requires Redis; the bundled instance needs no auth.
# UPTRACE_REDIS_PASSWORD=
# Optional. The bundled ClickHouse runs with the default user and no password.
# UPTRACE_CH_USER=default
# UPTRACE_CH_PASSWORD=

UPTRACE_DSN=http://project1_secret_token@localhost:14317/1

# -----------------------------------------------------------------------------
# ClickHouse (Uptrace storage - typically no changes needed)
# -----------------------------------------------------------------------------
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# -----------------------------------------------------------------------------
# Storage Configuration
# -----------------------------------------------------------------------------
# Storage provider (currently only 's3' is supported)
STORAGE_PROVIDER=s3

# S3 Storage Settings
# For AWS S3: Set region and credentials, leave S3_ENDPOINT empty
# For MinIO/LocalStack: Set S3_ENDPOINT to your local service URL
S3_BUCKET=your-bucket-name
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional: for MinIO/LocalStack
# S3_ENDPOINT=http://localhost:9000

# MinIO overlay (infra/compose/minio.compose.yml, epic #67).
# Uncomment this block exactly as written to run the local object store:
#
#   docker compose -f base.compose.yml -f dev.compose.yml -f minio.compose.yml up
#
# S3_ENDPOINT is the address the API uses (container network);
# S3_PUBLIC_ENDPOINT is the address a BROWSER uses, and it is what signed URLs
# are signed against. Signing a presigned PUT against http://minio:9000 gives
# the phone a URL that is perfectly valid and completely unreachable.
# S3_ENDPOINT=http://minio:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_BUCKET=evolvepath-dev
# S3_FORCE_PATH_STYLE=true
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# Storage Limits and Configuration
#
# These two are ENFORCED (issue #71). They were declared here and read by
# nothing for the life of the storage module; both upload paths now check them,
# and the web picker mirrors the defaults in apps/web/src/lib/mediaLimits.ts.
#
# 500 MiB in bytes. Sized for two minutes of phone video, which is the largest
# thing the product asks a user to upload.
MAX_FILE_SIZE=524288000
# An exact type, or ONE trailing /* wildcard, comma separated. An empty value
# denies every upload. application/pdf was dropped: no product surface accepts
# one, and "images only" was the documented intent.
ALLOWED_MIME_TYPES=image/*,video/*
# Signed URL expiration in seconds (1 hour)
SIGNED_URL_EXPIRY=3600
# Multipart upload part size in bytes (10MB)
STORAGE_PART_SIZE=10485760

# -----------------------------------------------------------------------------
# AI Provider (epic #20)
# -----------------------------------------------------------------------------
# Normally unset — the default below is OpenAI itself. Override it only for an
# egress proxy or for the fake OpenAI server the e2e suite runs against, which
# sets it to http://fake-openai:8089/v1 through infra/compose/fake-openai.compose.yml.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Hard deadline for one AI generation, in milliseconds. Sized for a
# reasoning-tier model on a long planning prompt, not for a short nudge.
AI_REQUEST_TIMEOUT_MS=60000

# Video -> frames (epic #67). The gateway can only send images, so a form-check
# video reaches the coach as a handful of evenly spaced JPEGs.
#
# AI_VIDEO_MAX_FRAMES is CLAMPED to 1-16: typing 100 gets you 16, not a boot
# failure, because too many frames is a bill rather than a broken deploy.
# AI_VIDEO_MAX_SECONDS is a REFUSAL rather than a clamp — sampling the first
# two minutes of a ten-minute video would hand the coach frames of something
# the user did not ask about.
AI_VIDEO_MAX_FRAMES=8
AI_VIDEO_MAX_SECONDS=120
# Both binaries are in the API image already; override only for an unusual host.
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Largest single image the AI gateway will inline into a request, in bytes.
# Bounds one AI call, not one upload — storage has its own MAX_FILE_SIZE.
AI_MAX_IMAGE_BYTES=20971520

# Most images one AI call may carry, counted after a video expands to its
# sampled frames.
AI_MAX_IMAGES_PER_CALL=10

# ---------------------------------------------------------------------------
# Coaching notifications (epic E12)
# ---------------------------------------------------------------------------

# The decision engine's cron, which scans for moments worth interrupting every
# five minutes. Default on.
#
# An OFF SWITCH, not a feature flag: this engine's failure mode is sending
# people messages, so an operator investigating "why is everyone getting
# notifications at 3am" needs to stop it in one restart rather than by reverting
# a deploy. The on-demand `POST /api/auth/test/run-job` route (non-production)
# is deliberately NOT gated by this, so a test can still prove the pipeline
# works while the cron is parked.
COACHING_NOTIFICATIONS_ENABLED=true

# ---------------------------------------------------------------------------
# Weekly review and planning (epic E10)
# ---------------------------------------------------------------------------

# The number of recurring commitments past which the product says "replace
# something rather than add another habit" (PRD §48). A SOFT cap: the warning is
# data on the response and never an exception, because a person who deliberately
# wants a heavy week is not making a mistake the software should refuse.
WEEKLY_LOAD_SOFT_CAP=8

# Stops the hourly sweep that prepares each user's review at their chosen day
# and time. Set to true for integration tests and the e2e stack: a background
# job writing reviews for every seeded user turns a deterministic assertion into
# a race.
WEEKLY_REVIEW_CRON_DISABLED=false

# ---------------------------------------------------------------------------
# The Health domain (epic E09)
# ---------------------------------------------------------------------------

# Stops the daily sweep that looks for workout programs that are not working
# (PRD §43) and raises plan-change proposals about them. Set to true for
# integration tests and the e2e stack, for the same reason as the weekly one: a
# background job raising proposals for every seeded user turns a deterministic
# assertion into a race.
WORKOUT_ADAPTATION_CRON_DISABLED=false

# ---------------------------------------------------------------------------
# Web push (epic E12)
# ---------------------------------------------------------------------------

# VAPID keys, generated once per deployment with:
#
#   npx web-push generate-vapid-keys
#
# `WEB_PUSH_SUBJECT` is a `mailto:` address or an https URL — a push service
# uses it to contact whoever operates this deployment.
#
# ALL THREE ARE OPTIONAL. Without them the push channel is simply inactive: the
# switch on /settings/notifications reads "Push is not configured on this
# server", and every user still gets the inbox row and the live update. That
# fallback needs no configuration and no code — a channel with no address is
# skipped by the dispatcher.
#
# ROTATING THESE INVALIDATES EVERY EXISTING SUBSCRIPTION, because each browser
# signed up against the old public key. It is a deliberate act, not a routine
# secret rotation.
WEB_PUSH_PUBLIC_KEY=
# A SECRET. Never logged, never returned by any endpoint, never sent to a browser.
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
