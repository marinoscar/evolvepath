// =============================================================================
// Prisma Schema - Evolve Path
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// User & Identity
// =============================================================================

model User {
  id                      String   @id @default(uuid()) @db.Uuid
  email                   String   @unique
  displayName             String?  @map("display_name")
  providerDisplayName     String?  @map("provider_display_name")
  profileImageUrl         String?  @map("profile_image_url")
  providerProfileImageUrl String?  @map("provider_profile_image_url")
  isActive                Boolean  @default(true) @map("is_active")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  identities             UserIdentity[]
  userRoles              UserRole[]
  userSettings           UserSettings?
  auditEvents            AuditEvent[]           @relation("ActorEvents")
  settingsUpdates        SystemSettings[]       @relation("SettingsUpdater")
  refreshTokens          RefreshToken[]         @relation("UserRefreshTokens")
  allowlistEntriesAdded  AllowedEmail[]         @relation("AllowlistAddedBy")
  allowlistEntry         AllowedEmail?          @relation("AllowlistClaimedBy")
  deviceCodes            DeviceCode[]           @relation("UserDeviceCodes")
  storageObjects         StorageObject[]        @relation("UserStorageObjects")
  personalAccessTokens   PersonalAccessToken[]  @relation("UserPersonalAccessTokens")
  credentialUpdates      Credential[]           @relation("CredentialUpdatedBy")
  notificationDeliveries NotificationDelivery[] @relation("UserNotificationDeliveries")
  notifications          Notification[]         @relation("UserNotifications")
  aiInvocations          AiInvocation[]         @relation("UserAiInvocations")

  // EvolvePath core domain (epic E02)
  bestSelfProfile BestSelfProfile? @relation("UserBestSelfProfile")
  outcomes        Outcome[]        @relation("UserOutcomes")
  plans           Plan[]           @relation("UserPlans")
  planVersions    PlanVersion[]    @relation("UserPlanVersions")
  routines        Routine[]        @relation("UserRoutines")
  commitments     Commitment[]     @relation("UserCommitments")
  evidence        Evidence[]       @relation("UserEvidence")
  reflections     Reflection[]     @relation("UserReflections")
  domainModes     DomainMode[]     @relation("UserDomainModes")

  // Onboarding and the typed preferences the product reasons about (epic E04)
  profile UserProfile? @relation("UserProfile")

  // The Today screen (epic E05)
  dailyCheckIns DailyCheckIn[] @relation("UserDailyCheckIns")

  // The Family domain (epic E08)
  familyMembers FamilyMember[] @relation("UserFamilyMembers")
  rituals       Ritual[]       @relation("UserRituals")

  // E12 (#49): the coaching decision log and this account's push endpoints.
  notificationInteractions NotificationInteraction[] @relation("UserNotificationInteractions")
  pushSubscriptions        PushSubscription[]        @relation("UserPushSubscriptions")

  // The AI coach and what it may remember (epic E06)
  coachConversations  CoachConversation[]  @relation("UserCoachConversations")
  planChangeProposals PlanChangeProposal[] @relation("UserPlanChangeProposals")
  memoryInsights      MemoryInsight[]      @relation("UserMemoryInsights")
  obstacles           Obstacle[]           @relation("UserObstacles")

  // The weekly loop (epic E10)
  weeklyReviews WeeklyReview[] @relation("UserWeeklyReviews")
  weeklyPlans   WeeklyPlan[]   @relation("UserWeeklyPlans")

  // The Health domain (epic E09)
  customExercises Exercise[]       @relation("UserCustomExercises")
  workoutPrograms WorkoutProgram[] @relation("UserWorkoutPrograms")
  workoutSessions WorkoutSession[] @relation("UserWorkoutSessions")
  bodyWeightLogs  BodyWeightLog[]  @relation("UserBodyWeightLogs")

  @@map("users")
}

model UserIdentity {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String
  providerSubject String   @map("provider_subject")
  providerEmail   String?  @map("provider_email")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@map("user_identities")
}

// =============================================================================
// RBAC - Roles & Permissions
// =============================================================================

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  // Relations
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  name        String  @unique
  description String?

  // Relations
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

// =============================================================================
// Settings
// =============================================================================

model SystemSettings {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @unique
  value           Json
  version         Int      @default(1)
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  updatedByUser User? @relation("SettingsUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

model UserSettings {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  value     Json
  version   Int      @default(1)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

// =============================================================================
// Audit
// =============================================================================

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String   @map("target_type")
  targetId    String   @map("target_id")
  meta        Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  // Relations
  actorUser User? @relation("ActorEvents", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_events")
}

// =============================================================================
// Refresh Tokens (for token rotation)
// =============================================================================

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  // Relations
  user User @relation("UserRefreshTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// =============================================================================
// Personal Access Tokens (PAT)
// =============================================================================

enum PatDurationUnit {
  minutes
  days
  months
}

model PersonalAccessToken {
  id            String          @id @default(uuid()) @db.Uuid
  userId        String          @map("user_id") @db.Uuid
  name          String
  tokenHash     String          @unique @map("token_hash")
  tokenPrefix   String          @map("token_prefix")
  durationValue Int             @map("duration_value")
  durationUnit  PatDurationUnit @map("duration_unit")
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz
  lastUsedAt    DateTime?       @map("last_used_at") @db.Timestamptz
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  revokedAt     DateTime?       @map("revoked_at") @db.Timestamptz

  // Relations
  user User @relation("UserPersonalAccessTokens", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("personal_access_tokens")
}

// =============================================================================
// Allowlist (Email Access Control)
// =============================================================================

model AllowedEmail {
  id          String    @id @default(uuid()) @db.Uuid
  email       String    @unique
  addedById   String?   @map("added_by_id") @db.Uuid
  addedAt     DateTime  @default(now()) @map("added_at") @db.Timestamptz
  claimedById String?   @unique @map("claimed_by_id") @db.Uuid
  claimedAt   DateTime? @map("claimed_at") @db.Timestamptz
  notes       String?

  // Relations
  addedBy   User? @relation("AllowlistAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  claimedBy User? @relation("AllowlistClaimedBy", fields: [claimedById], references: [id], onDelete: SetNull)

  @@map("allowed_emails")
}

// =============================================================================
// Device Authorization Flow (RFC 8628)
// =============================================================================

enum DeviceCodeStatus {
  pending
  approved
  denied
  expired
}

model DeviceCode {
  id         String           @id @default(uuid()) @db.Uuid
  deviceCode String           @unique @map("device_code")
  userCode   String           @unique @map("user_code")
  userId     String?          @map("user_id") @db.Uuid
  status     DeviceCodeStatus @default(pending)
  clientInfo Json?            @map("client_info")
  scopes     String[]
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User? @relation("UserDeviceCodes", fields: [userId], references: [id], onDelete: Cascade)

  @@index([deviceCode])
  @@index([userCode])
  @@index([status, expiresAt])
  @@index([userId])
  @@map("device_codes")
}

// =============================================================================
// Storage Objects
// =============================================================================

enum StorageObjectStatus {
  pending // Upload initiated, awaiting chunks
  uploading // Chunks being uploaded
  processing // Post-upload processing in progress
  ready // Available for use
  failed // Upload or processing failed
}

model StorageObject {
  id              String              @id @default(uuid()) @db.Uuid
  name            String // Original filename
  size            BigInt // Total size in bytes (BigInt for GB-scale)
  mimeType        String              @map("mime_type")
  storageKey      String              @unique @map("storage_key") // S3 object key
  storageProvider String              @default("s3") @map("storage_provider")
  bucket          String?
  status          StorageObjectStatus @default(pending)
  s3UploadId      String?             @map("s3_upload_id") // S3 multipart upload ID
  metadata        Json? // JSONB for flexible metadata
  uploadedById    String?             @map("uploaded_by_id") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  uploadedBy User?                @relation("UserStorageObjects", fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks     StorageObjectChunk[]

  @@index([uploadedById])
  @@index([status])
  @@index([createdAt])
  @@map("storage_objects")
}

model StorageObjectChunk {
  id         String   @id @default(uuid()) @db.Uuid
  objectId   String   @map("object_id") @db.Uuid
  partNumber Int      @map("part_number") // S3 part number (1-10000)
  eTag       String   @map("e_tag") // S3 ETag for verification
  size       BigInt // Chunk size in bytes
  uploadedAt DateTime @default(now()) @map("uploaded_at") @db.Timestamptz

  // Relations
  object StorageObject @relation(fields: [objectId], references: [id], onDelete: Cascade)

  @@unique([objectId, partNumber])
  @@index([objectId])
  @@map("storage_object_chunks")
}

// =============================================================================
// Encrypted Credential Store  (issue #115, epic #108)
// =============================================================================
//
// Runtime-configured secrets (an SMTP password, an OAuth client secret, a
// second bucket's S3 key, ...) addressed by (purpose, name) rather than one
// column per consumer, so every future secret reuses this table instead of
// inventing its own column, its own encrypt call, and its own chance to leak.
//
// `secret` holds ONLY the opaque base64 ciphertext produced by
// `encryptSecret()` in `common/crypto/secret-cipher.ts`, encrypted under
// `purpose` as the sub-key derivation label — a ciphertext lifted from one
// row cannot be decrypted under a different purpose. This model stores
// ciphertext and non-secret metadata only; it never sees plaintext, and
// Prisma performs no encryption of its own.
//
// NEVER select `secret` into anything that reaches an API response or a log
// line. `CredentialsService` is the sole reader/writer and is what actually
// enforces that split (a plaintext-returning method for server-side
// consumers, a metadata-only method for presentation) — this comment is the
// signpost, not the guarantee.
model Credential {
  id              String   @id @default(uuid()) @db.Uuid
  purpose         String
  name            String
  // Opaque [iv][authTag][ciphertext] payload, base64-encoded by
  // encryptSecret(). @db.Text (not the default `varchar`) because a base64
  // AES-GCM payload has no meaningful bound: encrypted key material,
  // passwords, or tokens of arbitrary length must never be truncated.
  secret          String   @db.Text
  // Non-secret display aid for the admin UI (e.g. last 4 chars, or a fixed
  // mask like '••••'). Nullable: a credential can exist before anyone has
  // decided how to hint it, and some secrets have no meaningful suffix to show.
  hint            String?
  // Human-readable description for the admin UI. Nullable for the same reason.
  label           String?
  updatedByUserId String?  @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  //
  // onDelete: SetNull — deliberately NOT Cascade. A credential is
  // infrastructure shared by whatever consumer looks it up by (purpose,
  // name); the admin who last set it is provenance, not an owner the
  // credential's lifetime should depend on. Offboarding the user who last
  // typed in the SMTP password must not silently delete a working SMTP
  // configuration — that failure mode (email breaks because someone left
  // the company) is exactly what this FK behaviour avoids. The credential
  // outliving its last editor is correct; losing it is not.
  updatedByUser User? @relation("CredentialUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([purpose, name])
  @@map("credentials")
}

// =============================================================================
// Notification Deliveries (issue #125, epic #109)
// =============================================================================
//
// One row per delivery ATTEMPT of an event (#121, `notification-events.ts`)
// over a channel, to a recipient. This is the answer to "did the user
// actually get it?" — the first question asked when something goes wrong,
// and epic #109's own success criterion 7: a delivery record exists for
// every attempt, with the provider's message id or error.
//
// -----------------------------------------------------------------------------
// eventKey — plain string, NOT a foreign key
// -----------------------------------------------------------------------------
// Events are declared in code (`notification-events.ts`, #121), not in a
// database table — `findEvent()` there returns `undefined` rather than
// throwing for a key it doesn't recognize, precisely because callers may be
// holding a key that came from persisted data written before the event was
// renamed or removed. An FK into an "events" table would force a migration
// (and a backfill, or a placeholder row) every time the registry changes,
// which is exactly the coupling #121 built the registry to avoid. A delivery
// record must outlive the event definition that produced it.
//
// -----------------------------------------------------------------------------
// channel — ALSO a plain string, not a Prisma enum (deliberately asymmetric
// with `status` below)
// -----------------------------------------------------------------------------
// `NotificationChannel` in `notification-events.ts` is explicitly derived
// from a plain array (`NOTIFICATION_CHANNELS`) so that adding `'push'` later
// (epic #109 reserves it) costs one edit to that array, not a migration. A
// Postgres enum on this column would quietly reintroduce that migration: the
// set of valid channels would live in two places — the code registry and
// this column's type — and adding one would require updating both. The
// registry is the single source of truth for what channels exist; this
// column just records which one a given attempt used.
//
// -----------------------------------------------------------------------------
// status — IS a Prisma enum
// -----------------------------------------------------------------------------
// Unlike eventKey/channel, `status` is not registry data — it is this
// table's own delivery state machine, owned entirely by the dispatcher, and
// nothing outside this table grows it. It follows the convention this schema
// already uses for exactly this shape of field (`DeviceCodeStatus`,
// `StorageObjectStatus`): a small, closed, code-owned set of states is a
// Postgres enum here, so the database itself rejects a delivery row written
// with anything other than queued/sent/failed.
//
// -----------------------------------------------------------------------------
// userId — nullable; recipient — the actual destination used
// -----------------------------------------------------------------------------
// `allowlist.invitation` (#121) is sent to an email address with no user
// account yet (#128) — there is no user row to point to, so `userId` must be
// nullable. `recipient` is what makes that case complete: it is the actual
// destination address used for THIS delivery, captured independently of the
// user relation, so the record stands on its own with `userId` null, and
// stays historically accurate even if the user's email later changes.
//
// -----------------------------------------------------------------------------
// onDelete: SetNull on the user relation
// -----------------------------------------------------------------------------
// Matches the audit-trail precedent this schema already sets for
// `AuditEvent.actorUserId` and `Credential.updatedByUser`: a delivery record
// is a history of what the application sent, and deleting a user account
// should not retroactively erase the evidence of what was sent to them —
// particularly for `security.*` events (#121), which are exactly the ones an
// incident review is most likely to need after the account in question no
// longer exists. Nothing is lost by nulling the FK: `recipient` already
// carries the actual destination independently of it. A GDPR-style request
// to purge one user's PII is a deliberate, targeted scrub of these rows (and
// `recipient` specifically) — not something an ON DELETE clause should do
// silently and irreversibly as a side effect of an unrelated user-deletion
// path elsewhere in the app.
//
// -----------------------------------------------------------------------------
// Indexes — exactly the two queries this table is known to serve
// -----------------------------------------------------------------------------
// Every index is a write cost on a table that grows with every notification
// sent, so nothing speculative is added beyond what #125 itself names:
//   - [userId, eventKey]: "did this user get this event?" — an equality
//     filter on both columns, from an account's delivery history view.
//   - [status, createdAt]: "what failed recently?" — status = 'failed'
//     filtered and ordered by recency, for on-call triage.
model NotificationDelivery {
  id                String                     @id @default(uuid()) @db.Uuid
  eventKey          String                     @map("event_key")
  userId            String?                    @map("user_id") @db.Uuid
  recipient         String
  channel           String
  status            NotificationDeliveryStatus @default(queued)
  providerMessageId String?                    @map("provider_message_id")
  // Provider errors (SMTP rejections, SES API errors, ...) have no useful
  // length bound — @db.Text, same reasoning as Credential.secret above.
  error             String?                    @db.Text
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  // Relations
  user User? @relation("UserNotificationDeliveries", fields: [userId], references: [id], onDelete: SetNull)

  // E12 (#49).
  interactions NotificationInteraction[]

  @@index([userId, eventKey])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

enum NotificationDeliveryStatus {
  queued
  sent
  failed
}

// =============================================================================
// Notifications — the in-app notification centre store (issue #127, epic #109)
// =============================================================================
//
// THE PRIMARY SURFACE OF THE BROWSER CHANNEL, NOT A CACHE OF WHAT SSE SENT.
//
// That ordering is the whole reason this table exists. `Notification`
// permission is denied by a large share of users, and once denied it is
// effectively permanent — the page cannot re-prompt. A browser channel that
// existed only as an OS toast would therefore not exist at all for those
// accounts. So the durable, per-user list is the feature; the SSE stream
// (`notification-stream.service.ts`) makes it live, and the native toast is a
// decoration on top that degrades to nothing.
//
// Read the second consequence too: SSE IS NOT A DELIVERY GUARANTEE. Events
// published while a tab is disconnected are lost — `EventSource` reconnects
// but replays nothing, and the per-process subscriber registry does not fan
// out across replicas. Because rows land here first and the stream is
// published second, a client that refetches this table on (re)connect sees
// everything regardless. That is the designed recovery path, and it is why
// there is no event-replay machinery anywhere in #127.
//
// -----------------------------------------------------------------------------
// HOW THIS DIFFERS FROM `notification_deliveries` (#125), WHICH IS NOT THE SAME
// TABLE WITH A DIFFERENT NAME
// -----------------------------------------------------------------------------
//
// `notification_deliveries` is the OPERATOR's record: one row per ATTEMPT, per
// channel, answering "did we try, and what did the provider say?". It records
// email attempts too, it keeps rows for recipients with no account, and it is
// never shown to the user it is about.
//
// `notifications` is the USER's inbox: one row per thing they should see, only
// for the browser channel, only for real accounts, with read state they own.
// An email send writes a delivery row and no row here — there is nothing for
// the bell to show about a message that went to their mailbox.
//
// Merging the two would mean either showing users provider error strings, or
// filtering an operator table by channel on every bell render. They answer
// different questions for different audiences and are kept apart.
// =============================================================================

model Notification {
  id     String @id @default(uuid()) @db.Uuid
  // NOT NULL, unlike NotificationDelivery.userId. An inbox belongs to an
  // account by definition; there is no "notification centre" for a recipient
  // with no login (#128's `allowlist.invitation` case), which is exactly why
  // the browser channel's resolveTo returns null for them.
  userId String @map("user_id") @db.Uuid

  // Plain string, NOT a foreign key — the same reasoning written out at length
  // on NotificationDelivery.eventKey. Events are declared in code
  // (`notification-events.ts`, #121) and `findEvent` returns undefined rather
  // than throwing precisely because persisted rows outlive their definitions.
  // An FK would force a migration every time the registry changed.
  eventKey String @map("event_key")

  // RENDERED AT WRITE TIME, not at read time. The alternative — store the
  // event payload as JSONB and render in the bell — means an old row renders
  // through today's template, so editing copy silently rewrites history and a
  // removed event's rows become unrenderable. What the user was told is a
  // fact; it is frozen here.
  title String
  // @db.Text for the same reason as Credential.secret and
  // NotificationDelivery.error: a rendered body has no meaningful length
  // bound, and silently truncating what a user was told is worse than storing
  // a long string. (Postgres `text` has no performance penalty over `varchar`.)
  body  String @db.Text

  // Where the bell should send the user, as a ROOT-RELATIVE PATH ("/settings",
  // "/admin/users?id=…"), never an absolute URL.
  //
  // THIS IS A SECURITY BOUNDARY, ENFORCED IN CODE AT WRITE TIME
  // (`browser-notification.channel.ts`). The web client will put this value in
  // an href or a router navigation; an absolute URL makes every notification a
  // potential open redirect, and a `javascript:` scheme makes it script
  // execution in the app's own origin. The column cannot express that
  // constraint, so the writer enforces it and drops a link it cannot vouch
  // for rather than storing it and hoping the client is careful.
  //
  // Nullable: most notifications have nowhere specific to go.
  link String?

  // A TIMESTAMP, NOT A BOOLEAN. `readAt IS NULL` answers "is it unread?" just
  // as well as `read = false` does, and additionally answers "when did they
  // see it?" — which is the question asked when someone reports acting late on
  // a security alert. A boolean would have to grow this column later anyway.
  readAt DateTime? @map("read_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  // NO `updatedAt`. The only mutation this row ever undergoes is being marked
  // read, and `readAt` already timestamps that with more precision than an
  // `updatedAt` would carry. A second, redundant answer to "when did this
  // change?" is a second thing to keep consistent for no reader.

  // Relations
  //
  // onDelete: Cascade — deliberately the OPPOSITE of
  // NotificationDelivery.user's SetNull, and the contrast is the point. A
  // delivery record is an audit trail that must outlive the account it
  // describes ("did we email this person before they were offboarded?"). An
  // inbox is personal data with no reader once the account is gone: keeping
  // orphaned rows would retain rendered titles and bodies about a deleted user
  // forever, and `userId` is NOT NULL here so SetNull is not even expressible.
  user User @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)

  // E12 (#49): the OPENED/ACTIONED rows recorded against this inbox row.
  interactions NotificationInteraction[]

  // The two queries this table actually serves, and nothing speculative.
  //
  // 1. THE UNREAD BADGE: `where { userId, readAt: null }`, run on every bell
  //    render and on every SSE (re)connect — by far the hottest query here.
  //    (Ideally a partial index `WHERE read_at IS NULL`, which Prisma cannot
  //    express declaratively; the composite covers the same predicate and
  //    stays in one place the schema owns.)
  @@index([userId, readAt])
  // 2. THE RECENT LIST: `where { userId } orderBy { createdAt: desc }`.
  //    `sort: Desc` matters — a plain ascending index makes Postgres walk it
  //    backwards for the newest page, which is the only page anyone loads.
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

// =============================================================================
// AI Observability (issue #21, epic #20)
// =============================================================================
//
// One row per AI operation, written on EVERY exit path — success, provider
// failure, invalid output, refusal — and on every test-connection attempt.
// This is the durable half of PRD §88 ("every AI operation is observable
// internally: model, prompt version, structured input and output, validation
// result, latency, token use, safety decision") and of PRD §117 (the prompt
// version is captured in logs).
//
// WHAT IS DELIBERATELY ABSENT: a column for the model's internal chain of
// thought. PRD §16 and §88 forbid storing or exposing it, and the cheapest way
// to keep that promise is to give the reasoning text nowhere to go. Reasoning
// TOKENS are counted (`reasoning_tokens`) because a bill is not a transcript.
//
// This is TELEMETRY, not product data, and that is why `userId` is
// `onDelete: SetNull` while the product tables cascade: deleting an account
// must not erase the record that those calls happened and what they cost.
// =============================================================================
// User profile (issue #100, epic E04)
// =============================================================================
//
// WHY A TABLE RATHER THAN `user_settings`: `user_settings` is a free-form JSONB
// document owned by the settings UI — the API never reasons about its contents.
// Everything here is read by the product's own logic and must be queryable and
// typed: E05's next-best-action sizes an action from `weekdayMinutes` and
// resolves "today" from `timezone`, E12's decision engine reads the quiet
// hours, and onboarding resumes from `onboardingStep`. A JSON blob would make
// each of those a full-document read plus a runtime parse.
//
// One row per user, created LAZILY on first write. `GET /auth/me` runs on every
// app boot and must not write: a missing row simply means "onboarding not
// finished", which is exactly what a brand-new account is.
// =============================================================================

/// Where the user is in the onboarding conversation (PRD §20). `DONE` is the
/// terminal step; `onboardingCompletedAt` is the authoritative "finished" flag
/// because a step can be revisited.
enum OnboardingStep {
  PROMISE
  VISION
  DOMAINS
  REALITY
  TIME
  HEALTH_BASELINE
  COACHING_STYLE
  PROPOSAL
  NOTIFICATIONS
  DONE
}

/// How direct the coach should be (PRD §20 step 7). Read by every AI persona
/// that speaks to the user, so it is a column rather than a settings key.
enum CoachingStyle {
  GENTLE
  BALANCED
  DIRECT
}

model UserProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  /// IANA zone. Everything that means "today" for this user resolves through
  /// it; an unparseable value falls back to UTC at the read site rather than
  /// failing the request.
  timezone String @default("UTC")
  locale   String @default("en")

  onboardingStep        OnboardingStep @default(PROMISE) @map("onboarding_step")
  onboardingCompletedAt DateTime?      @map("onboarding_completed_at") @db.Timestamptz

  coachingStyle CoachingStyle @default(BALANCED) @map("coaching_style")

  /// Stated availability on a normal weekday, in minutes. Nullable because a
  /// user who has not answered must not be given a fabricated budget.
  weekdayMinutes Int? @map("weekday_minutes")

  /// "HH:mm" local wall-clock. Stored as text on purpose: a time of day with no
  /// date has no instant, and a `time` column would invite a timezone bug.
  quietHoursStart String? @map("quiet_hours_start")
  quietHoursEnd   String? @map("quiet_hours_end")

  /// Stable keys from `OBSTACLE_OPTIONS`, not free text — E07 groups on them.
  obstacles String[] @default([])

  sixMonthVision String? @map("six_month_vision")

  /// The domains the user chose to work on. Reuses E02's `Domain` enum; there
  /// is deliberately no second copy of it.
  selectedDomains Domain[] @default([]) @map("selected_domains")

  /// Validated at the boundary by Zod (`user-profile.schema.ts`), not by the
  /// database: these shapes belong to onboarding's conversation and change with
  /// its copy, and neither should be a migration.
  domainReflections Json? @map("domain_reflections")
  healthBaseline    Json? @map("health_baseline")
  pendingProposal   Json? @map("pending_proposal")

  confidenceScore Int? @map("confidence_score")

  /// E12 (#49): caps, muted categories and anything else the coaching decision
  /// engine reads per user. JSON rather than columns for the same reason as
  /// `domainReflections` above — these are policy knobs whose shape moves with
  /// the engine, and `notification-policy.schema.ts` validates them at the
  /// boundary. `resolvePolicy` is total: an unparseable value yields defaults.
  /// Quiet hours are deliberately NOT in here: they already exist as
  /// `quietHoursStart/End` columns (E04-01) and there must be one home.
  notificationPolicy Json? @map("notification_policy")

  /// When the weekly review is prepared (PRD §50: "a recommended day/time
  /// chosen by user"). 0 = Sunday … 6 = Saturday, range-checked by the database
  /// as well as by Zod — an out-of-range weekday would silently never fire.
  weeklyReviewWeekday Int    @default(0) @map("weekly_review_weekday")
  /// 'HH:mm' local wall-clock, like `quietHoursStart`. The sweep runs hourly,
  /// so the minutes are documentation rather than a promise.
  weeklyReviewTime    String @default("17:00") @map("weekly_review_time")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation("UserProfile", fields: [userId], references: [id], onDelete: Cascade)

  /// "Who is stuck mid-onboarding?" — the only non-key query this table has.
  @@index([onboardingStep])
  @@map("user_profiles")
}

// =============================================================================

enum AiInvocationOperation {
  /// A real product call through AiGatewayService.invoke() (#26).
  invoke
  /// An admin or user "does this key work?" probe (#24, #25).
  test_connection

  @@map("ai_invocation_operation")
}

enum AiKeyScope {
  /// The caller's own BYOK key — every `invoke` is this.
  user
  /// The platform key, which serves only the admin catalog and admin test.
  platform

  @@map("ai_key_scope")
}

enum AiInvocationStatus {
  succeeded
  /// The provider could not be reached, refused the key, or errored.
  failed
  /// The provider answered, but the answer did not satisfy the contract.
  invalid_output
  /// The model declined to answer (an OpenAI `refusal` content part).
  refused

  @@map("ai_invocation_status")
}

model AiInvocation {
  id        String                @id @default(uuid()) @db.Uuid
  operation AiInvocationOperation
  keyScope  AiKeyScope            @map("key_scope")

  /// Nullable because the account may since have been deleted (SetNull below),
  /// not because a call can be anonymous.
  userId String? @map("user_id") @db.Uuid

  /// One of PERSONA_KEYS (#22). A plain string, not an FK or an enum, for the
  /// same reason `NotificationDelivery.eventKey` is: personas are declared in
  /// code and persisted rows outlive their definitions.
  persona String?

  provider String

  /// NULLABLE: a user-key test that skips the generate probe (no platform
  /// default model is configured) never names a model.
  model String?

  /// e.g. 'planner.v1' — PRD §117.
  promptVersion String? @map("prompt_version")

  /// The API's own request id (RequestIdMiddleware), for joining to app logs.
  requestId String? @map("request_id")

  /// The provider's `x-request-id`, for a support ticket with OpenAI.
  providerRequestId String? @map("provider_request_id")

  status    AiInvocationStatus
  errorCode String?            @map("error_code")

  /// REDACTED AND CAPPED AT 2000 CHARS BY THE WRITER (AiKeyRedactor, #26),
  /// never by the database. A column limit would truncate mid-key and leave a
  /// key fragment behind; the writer scrubs first, then caps.
  errorMessage String? @map("error_message") @db.Text

  inputTokens       Int? @map("input_tokens")
  outputTokens      Int? @map("output_tokens")
  cachedInputTokens Int? @map("cached_input_tokens")
  /// A COUNT, never the reasoning text. See the header.
  reasoningTokens   Int? @map("reasoning_tokens")

  latencyMs Int @map("latency_ms")

  /// Did the structured output satisfy its Zod contract? Null for operations
  /// that have no contract to satisfy (a listModels-only test).
  outputValid Boolean? @map("output_valid")

  /// The `SafetyDecision` (E06-06, #82) that governed this call: decision,
  /// category, source, matched rule id, prompt version.
  ///
  /// jsonb, not the free-text column this started as. The decision is five
  /// fields and the audit question is "which rule fired, and did a model or a
  /// regex decide?" — `safety_decision->>'source'` answers it; a bare 'allow'
  /// does not. Converted rather than dropped: nothing wrote the column before
  /// #82, and `to_jsonb` keeps any value that somehow did.
  safetyDecision Json? @map("safety_decision")

  attachmentCount Int @default(0) @map("attachment_count")

  /// The structured request/response AFTER redaction, capped at 32 KiB with a
  /// `{ "_truncated": true }` marker. NEVER raw provider bodies, never
  /// reasoning or chain of thought.
  input  Json?
  output Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  /// SetNull, not Cascade. See the header: a deleted account must not erase
  /// the cost record.
  user User? @relation("UserAiInvocations", fields: [userId], references: [id], onDelete: SetNull)

  /// "What did this user spend / how did their calls go?" — the support query.
  @@index([userId, createdAt])
  /// "How is the coach persona behaving?" — the tuning query.
  @@index([persona, createdAt])
  /// "What is failing right now?" — the operational query.
  @@index([status, createdAt])
  @@map("ai_invocations")
}

// =============================================================================
// Daily check-in (issue #43, epic E05)
// =============================================================================
//
// PRD §73: an optional one-tap "How does today feel?" that "can alter suggested
// action size". One row per user per LOCAL day, upserted — the question is
// asked once and the answer can be changed, so a history of taps would be noise.
//
// `dateLocal` is TEXT, not `@db.Date`, and that is deliberate: it is a label in
// the user's own timezone, and Prisma's `Date` mapping round-trips through UTC —
// which would file a 19:00 check-in in Costa Rica under the following day.
// =============================================================================

enum CheckInFeel {
  NORMAL
  PACKED
  LOW_ENERGY
  UNEXPECTED_PROBLEM
}

model DailyCheckIn {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// `YYYY-MM-DD` in the user's timezone. See the header for why it is text.
  dateLocal String      @map("date_local")
  feel      CheckInFeel

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation("UserDailyCheckIns", fields: [userId], references: [id], onDelete: Cascade)

  /// One answer per day. This constraint IS the upsert.
  @@unique([userId, dateLocal])
  @@map("daily_check_ins")
}

// =============================================================================
// EvolvePath core domain (epic E02)
// =============================================================================
//
// PRD §9 asks for one hierarchy, made explicit rather than implied by chat:
//
//   Best Self → Domains → Outcomes → Plans → Routines → Commitments →
//   Evidence → Reflection
//
// Every table below is one rung of it. Three decisions in here are load-bearing
// and are written down because a later reader will otherwise "simplify" them:
//
// 1. PLANS ARE VERSIONED, ALWAYS. `Plan` is an identity (one per outcome, and
//    nothing else); every field a user would call "the plan" lives on
//    `PlanVersion`. PRD §80/§103 require that a plan can change, that the user
//    can inspect WHY it changed, and that the old one stays readable. A
//    mutable plan row satisfies none of those: the rationale for a change has
//    nowhere to live and the previous shape is gone. `previousVersionId`
//    threads the lineage so "why did this change?" is a walk, not a guess.
//    Exactly one version per plan may be ACTIVE — enforced by a PARTIAL UNIQUE
//    INDEX hand-written in the migration, because Prisma's schema language
//    cannot express `WHERE status = 'ACTIVE'`.
//
// 2. EVIDENCE OUTLIVES ITS COMMITMENT. `Evidence.commitmentId` is `SetNull`,
//    never `Cascade`. PRD §103: "old commitments remain historical evidence".
//    A user who deletes a commitment is tidying their schedule, not disowning
//    the fact that they did the work — and momentum (E11) is computed from
//    evidence, so cascading would silently rewrite their history. The same
//    reasoning applies to `Reflection.commitmentId`.
//
// 3. EVERY TABLE CARRIES `user_id` REDUNDANTLY. `PlanVersion` could reach its
//    owner through plan → outcome → user, and `Routine` through one more hop.
//    They store `userId` anyway so an ownership check is a single indexed
//    predicate (`findFirst({ where: { id, userId } })`, the PAT pattern) rather
//    than a three-table join that is one refactor away from being dropped.
//    `onDelete: Cascade` on that relation is what makes account deletion whole.
// =============================================================================

/// The three life domains EvolvePath organises everything under (PRD §9).
enum Domain {
  WORK
  FAMILY
  HEALTH
}

enum OutcomeState {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum PlanVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  REJECTED
}

/// Who authored a version. E02 only ever writes USER; E04/E06 add AI proposals,
/// and the column exists from day one so that lands without a migration.
enum PlanAuthor {
  USER
  AI
}

enum RoutineTriggerType {
  TIME
  EVENT
}

enum RoutineFrequency {
  DAILY
  WEEKDAYS
  WEEKENDS
  WEEKLY
  CUSTOM
}

enum CommitmentStatus {
  PLANNED
  READY
  STARTED
  COMPLETED
  PARTIALLY_COMPLETED
  RESCHEDULED
  SKIPPED
  MISSED
  CANCELLED
}

/// Which of a commitment's three sizes the user actually did (PRD §44/§101).
/// Distinct from the status: "completed" and "completed the minimum version"
/// are different facts, and only the second one explains a thin week honestly.
enum CommitmentVersion {
  FULL
  SHORT
  MINIMUM
}

enum EvidenceSource {
  USER_LOG
  TIMER
  WORKOUT_LOG
  APP_FLOW
}

/// Per-domain posture (PRD §49). Later epics size the week from it; E02 only
/// stores it.
enum DomainModeKind {
  GROW
  MAINTAIN
  RECOVER
  PAUSE
}

/// Who the user is trying to become (PRD §10.2). One row per user, replaced
/// whole rather than patched — it is a statement, not a record set.
model BestSelfProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  identityStatement String? @map("identity_statement")
  workIdentity      String? @map("work_identity")
  familyIdentity    String? @map("family_identity")
  healthIdentity    String? @map("health_identity")
  sixMonthVision    String? @map("six_month_vision")

  motivations String[]
  reasons     String[]

  /// Set every time the profile is replaced. "When did you last look at who
  /// you said you wanted to be?" is a coaching question (E06), not an audit one.
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation("UserBestSelfProfile", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@map("best_self_profiles")
}

/// A meaningful result in one domain (PRD §10.4).
model Outcome {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  domain      Domain
  title       String
  description String?

  /// @db.Date, deliberately: a target date has no time of day, and a
  /// Timestamptz would shift by a day for anyone east or west of the writer.
  targetDate DateTime? @map("target_date") @db.Date

  /// 1–5. Bounds are enforced by the DTO, not a CHECK constraint — the API is
  /// the only writer, and a CHECK would make widening the scale a migration.
  importance Int @default(3)

  motivation        String?
  state             OutcomeState @default(ACTIVE)
  successDefinition String?      @map("success_definition")
  /// 1–5.
  userConfidence    Int?         @map("user_confidence")
  archivedAt        DateTime?    @map("archived_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user        User         @relation("UserOutcomes", fields: [userId], references: [id], onDelete: Cascade)
  plan        Plan?
  commitments Commitment[]

  @@index([userId, domain])
  @@index([userId, state])
  @@map("outcomes")
}

/// The identity of an outcome's plan, and nothing else. Everything a user would
/// call "the plan" lives on PlanVersion — see decision 1 in the header.
model Plan {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @map("user_id") @db.Uuid
  outcomeId String @unique @map("outcome_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user            User                 @relation("UserPlans", fields: [userId], references: [id], onDelete: Cascade)
  outcome         Outcome              @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  versions        PlanVersion[]
  proposals       PlanChangeProposal[] @relation("PlanChangeProposals")
  /// The Health domain (epic E09): the workout programs approved into this plan.
  workoutPrograms WorkoutProgram[]

  @@index([userId])
  @@map("plans")
}

model PlanVersion {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  planId String @map("plan_id") @db.Uuid

  /// Monotonic per plan, starting at 1. Unique with planId.
  version Int
  status  PlanVersionStatus @default(DRAFT)

  /// WHY this version exists, in the user's words. PRD §103's "the user can
  /// inspect why the plan changed" is this column plus the lineage below.
  rationale String?

  /// Minutes per week the version expects to cost.
  expectedWeeklyLoad Int?    @map("expected_weekly_load")
  fallbackStrategy   String? @map("fallback_strategy")

  userApproved Boolean    @default(false) @map("user_approved")
  createdBy    PlanAuthor @default(USER) @map("created_by")

  /// SetNull, not Cascade: deleting an ancestor must not delete the history
  /// that descends from it.
  previousVersionId String? @map("previous_version_id") @db.Uuid

  activeFrom  DateTime? @map("active_from") @db.Timestamptz
  activeUntil DateTime? @map("active_until") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user            User          @relation("UserPlanVersions", fields: [userId], references: [id], onDelete: Cascade)
  plan            Plan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  previousVersion PlanVersion?  @relation("PlanVersionLineage", fields: [previousVersionId], references: [id], onDelete: SetNull)
  nextVersions    PlanVersion[] @relation("PlanVersionLineage")
  routines        Routine[]
  commitments     Commitment[]

  /// Proposals whose acceptance produced this version (SetNull on the other
  /// side: deleting a version must not erase the record of the decision).
  appliedByProposals PlanChangeProposal[] @relation("ProposalAppliedVersion")

  @@unique([planId, version])
  @@index([userId])
  @@map("plan_versions")
}

/// A repeatable behaviour a version prescribes. E02 stores routines; nothing
/// materialises commitments from them yet (E08 recurrence).
model Routine {
  id            String @id @default(uuid()) @db.Uuid
  userId        String @map("user_id") @db.Uuid
  planVersionId String @map("plan_version_id") @db.Uuid

  title  String
  domain Domain

  triggerType  RoutineTriggerType @default(TIME) @map("trigger_type")
  triggerValue String?            @map("trigger_value")

  frequency  RoutineFrequency @default(WEEKDAYS)
  /// 0 = Sunday … 6 = Saturday. Only meaningful when frequency = CUSTOM.
  daysOfWeek Int[]            @map("days_of_week")

  /// 'HH:mm' in the user's local time. Stored as text, not a time column: it is
  /// an intention ("about half six"), not an instant, and E04 adds the timezone
  /// that would be needed to resolve it.
  preferredTime String? @map("preferred_time")

  estimatedDurationMin Int     @map("estimated_duration_min")
  minimumDurationMin   Int     @map("minimum_duration_min")
  fallbackBehavior     String? @map("fallback_behavior")

  active    Boolean @default(true)
  sortOrder Int     @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user            User             @relation("UserRoutines", fields: [userId], references: [id], onDelete: Cascade)
  planVersion     PlanVersion      @relation(fields: [planVersionId], references: [id], onDelete: Cascade)
  commitments     Commitment[]
  /// A ritual (epic E08) surfaces itself on the Path by pointing at a routine it
  /// keeps in sync. SetNull on the ritual side, so deleting the routine never
  /// deletes the ritual.
  rituals         Ritual[]
  /// The FULL workout template this routine schedules, when it is a workout
  /// (epic E09). 1:1, and what lets a routine-targeted plan change reach a
  /// template.
  workoutTemplate WorkoutTemplate?

  @@index([planVersionId])
  @@index([userId])
  @@map("routines")
}

/// One intended action at one time. Every link upward is optional and SetNull:
/// a commitment survives the plan it came from (PRD §103).
model Commitment {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  domain Domain
  title  String

  outcomeId     String? @map("outcome_id") @db.Uuid
  planVersionId String? @map("plan_version_id") @db.Uuid
  routineId     String? @map("routine_id") @db.Uuid

  scheduledStart DateTime  @map("scheduled_start") @db.Timestamptz
  scheduledEnd   DateTime? @map("scheduled_end") @db.Timestamptz

  importance     Int     @default(3)
  commitmentType String? @map("commitment_type")

  /// The three sizes of the same intention (PRD §57). The minimum version is
  /// what keeps a streak alive on a bad day.
  ///
  /// The `*Version` column is the TITLE and the `*Minutes` column is how long
  /// that size takes. Two columns rather than one JSON object because both are
  /// read on every Today request — the next-best-action sizer picks a version by
  /// comparing its minutes against the user's remaining budget (E05-01), and a
  /// blob would make that a parse per candidate per request.
  fullVersion    String? @map("full_version")
  shortVersion   String? @map("short_version")
  minimumVersion String? @map("minimum_version")
  fullMinutes    Int?    @map("full_minutes")
  shortMinutes   Int?    @map("short_minutes")
  minimumMinutes Int?    @map("minimum_minutes")

  status            CommitmentStatus @default(PLANNED)
  rescheduleCount   Int              @default(0) @map("reschedule_count")
  rescheduledFromId String?          @map("rescheduled_from_id") @db.Uuid

  skipReason    String?   @map("skip_reason")
  /// The user's own words about the skip. Separate from `skipReason` (the enum)
  /// because the enum is what E07 groups on and the text is what the coach
  /// reads back; neither should be parsed out of the other.
  skipNote      String?   @map("skip_note")
  userConfirmed Boolean   @default(false) @map("user_confirmed")
  startedAt     DateTime? @map("started_at") @db.Timestamptz
  completedAt   DateTime? @map("completed_at") @db.Timestamptz

  // ---------------------------------------------------------------------------
  // Execution state (issue #40, epic E05)
  // ---------------------------------------------------------------------------
  //
  // THE TIMER IS SERVER-DERIVED, and these two columns are why. `activeSeconds`
  // is time banked at the last pause; `activeSince` is when the current run
  // began, or null while paused. Elapsed time is always
  // `activeSeconds + (activeSince ? now - activeSince : 0)`, computed at read
  // time, so a reloaded page, a second device and a phone that slept all agree
  // — and a client clock cannot inflate the record.
  //
  // There is deliberately no PAUSED status: paused is `STARTED` with
  // `activeSince: null`. PRD §10.7 owns the status enum and a parallel notion of
  // "running" living in it would be two sources of truth for one fact.

  /// Non-null exactly while the timer is running.
  activeSince   DateTime? @map("active_since") @db.Timestamptz
  /// Active time banked up to the last pause, in seconds.
  activeSeconds Int       @default(0) @map("active_seconds")
  /// The 5/10/20/custom target the user chose at start, in minutes.
  timerMinutes  Int?      @map("timer_minutes")

  /// Which size was actually done. Defaults to FULL on completion when the user
  /// never selected a fallback.
  versionUsed  CommitmentVersion? @map("version_used")
  /// Reported on completion, or derived from `activeSeconds` when it is not.
  minutesSpent Int?               @map("minutes_spent")

  /// `[{title, minutes}]` from an applied decomposition, shown by the Start
  /// flow. Zod-validated at the boundary: the steps are coach output whose
  /// shape belongs to the prompt, and a column per step is not a thing.
  steps Json?

  decomposedFromId String? @map("decomposed_from_id") @db.Uuid

  // ---------------------------------------------------------------------------
  // The Family domain (issue #37, epic E08)
  // ---------------------------------------------------------------------------
  //
  // Both nullable and both SetNull, like every other link upward: a materialized
  // ritual occurrence is a commitment first. Deleting the ritual or the family
  // member must leave the record of what the user actually did untouched.

  /// Which workout this commitment runs, when it is one (epic E09). SetNull:
  /// deleting the program must not delete the record of the session the user
  /// already did against it.
  workoutTemplateId String? @map("workout_template_id") @db.Uuid

  /// The ritual that materialized this occurrence, when it came from one.
  ritualId       String? @map("ritual_id") @db.Uuid
  /// Who the commitment is with. Context, never an axis of measurement.
  familyMemberId String? @map("family_member_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user            User         @relation("UserCommitments", fields: [userId], references: [id], onDelete: Cascade)
  outcome         Outcome?     @relation(fields: [outcomeId], references: [id], onDelete: SetNull)
  planVersion     PlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: SetNull)
  routine         Routine?     @relation(fields: [routineId], references: [id], onDelete: SetNull)
  rescheduledFrom Commitment?  @relation("CommitmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Commitment[] @relation("CommitmentReschedule")
  /// SetNull, like every other history pointer here: deleting the big
  /// commitment must not delete the small one the user actually did.
  decomposedFrom  Commitment?  @relation("CommitmentDecomposition", fields: [decomposedFromId], references: [id], onDelete: SetNull)
  decomposedTo    Commitment[] @relation("CommitmentDecomposition")
  evidence        Evidence[]
  reflections     Reflection[]

  // E12 (#49): which coaching messages concerned this commitment. SetNull, so
  // the metric rows survive a deleted commitment.
  interactions NotificationInteraction[]
  ritual       Ritual?                   @relation(fields: [ritualId], references: [id], onDelete: SetNull)
  familyMember FamilyMember?             @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)

  // The Health domain (epic E09)
  workoutTemplate WorkoutTemplate? @relation(fields: [workoutTemplateId], references: [id], onDelete: SetNull)
  workoutSession  WorkoutSession?

  /// MATERIALIZATION IDEMPOTENCY (issue #37, epic E08). Re-running the
  /// materializer over the same horizon must not double-book an occurrence, and
  /// the guarantee is this index rather than a transaction: Postgres treats
  /// NULLs as distinct, so the commitments with no ritual are never in conflict
  /// with each other, while two rows for the same ritual at the same instant
  /// raise P2002 — which the materializer counts as `skipped`.
  @@unique([ritualId, scheduledStart])
  @@index([userId, scheduledStart])
  @@index([userId, status])
  @@index([planVersionId])
  /// "Does this user have a timer running?" — asked on every Today request and
  /// before every start, which auto-pauses whatever else is running.
  @@index([userId, status, activeSince])
  @@index([userId, ritualId])
  @@map("commitments")
}

/// A fact about what actually happened. Mapped to `evidence_items` because the
/// snake_case-plural table rule needs a countable noun; the model stays
/// `Evidence` so service code reads naturally.
model Evidence {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  /// SetNull — see decision 2 in the header.
  commitmentId String? @map("commitment_id") @db.Uuid

  /// Free label: 'completion', 'partial', 'start', 'timer', … Not an enum: new
  /// evidence kinds arrive with every domain epic and none of them should be a
  /// migration.
  evidenceType String         @map("evidence_type")
  source       EvidenceSource
  occurredAt   DateTime       @default(now()) @map("occurred_at") @db.Timestamptz

  quantitativeValue Float?  @map("quantitative_value")
  quantitativeUnit  String? @map("quantitative_unit")
  qualitativeValue  String? @map("qualitative_value")
  /// 0–1.
  confidence        Float?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user       User        @relation("UserEvidence", fields: [userId], references: [id], onDelete: Cascade)
  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt])
  @@index([commitmentId])
  @@map("evidence_items")
}

/// What the user made of it. `relatedType`/`relatedId` are a soft pointer
/// rather than four nullable FKs: reflections attach to whatever the product
/// grows next (a day, a week, a workout) and none of those should be a
/// migration on this table.
model Reflection {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// 'commitment' | 'outcome' | 'plan_version' | 'day'
  relatedType String  @map("related_type")
  relatedId   String? @map("related_id") @db.Uuid

  /// Denormalised from relatedId when relatedType = 'commitment', so the
  /// common join is an FK and stays SetNull with the rest of the history.
  commitmentId String? @map("commitment_id") @db.Uuid

  userText     String?  @map("user_text")
  aiSummary    String?  @map("ai_summary")
  frictionTags String[] @map("friction_tags")

  mood                Int?
  perceivedDifficulty Int? @map("perceived_difficulty")
  satisfaction        Int?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user       User        @relation("UserReflections", fields: [userId], references: [id], onDelete: Cascade)
  commitment Commitment? @relation(fields: [commitmentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([relatedType, relatedId])
  @@map("reflections")
}

/// Current posture per domain (PRD §49). At most one row per user per domain;
/// a missing row means GROW and the API synthesises it rather than seeding.
model DomainMode {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  domain        Domain
  mode          DomainModeKind @default(GROW)
  reason        String?
  effectiveFrom DateTime       @default(now()) @map("effective_from") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation("UserDomainModes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, domain])
  @@map("domain_modes")
}

// =============================================================================
// The Family domain — members and rituals (issue #37, epic E08)
// =============================================================================
//
// TWO DECISIONS THAT ARE THE WHOLE POINT OF THIS SECTION.
//
// 1. THE MEMBER RECORD IS DELIBERATELY POOR. PRD §33 fixes it at nickname,
//    relationship and an optional birthday; VISION §50 says why — the people
//    in it never consented to being modeled. There is no notes column, no
//    tags, no mood, no sentiment, no score, and none may be added: a free-text
//    field on a person the user did not ask permission from becomes a hidden
//    assessment the moment the coach reads it back. The privacy boundary is
//    enforced here, by the absence of columns, rather than by convention in a
//    service somewhere.
//
// 2. A RITUAL IS A RULE, NOT A SCHEDULE. It stores the recurrence and the two
//    durations and nothing about any particular evening; the materializer
//    (issue #41) turns it into real `Commitment` rows a week at a time, which
//    is what Today ranks and what the user completes, moves or skips through
//    the ordinary lifecycle. Nothing in this epic re-implements that lifecycle.
// =============================================================================

/// How the user describes the person. Rendered in this order by the UI select.
enum FamilyRelationship {
  PARTNER
  CHILD
  PARENT
  SIBLING
  FRIEND
  OTHER
}

/// Someone the user shares a ritual with. See decision 1 above before adding a
/// column here: the short list IS the feature.
model FamilyMember {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  nickname     String             @db.VarChar(40)
  relationship FamilyRelationship

  /// Date-only, and read date-only. The year may be a placeholder — the UI
  /// sends 1900 when the user does not know it — so every consumer ignores the
  /// year and no code path may resolve this through a timezone.
  birthday DateTime? @db.Date

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user        User         @relation("UserFamilyMembers", fields: [userId], references: [id], onDelete: Cascade)
  rituals     Ritual[]
  commitments Commitment[]

  @@index([userId])
  @@map("family_members")
}

/// A recurring family behaviour the user is trying to protect (PRD §34).
model Ritual {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String  @map("user_id") @db.Uuid
  title          String  @db.VarChar(120)
  purpose        String? @db.VarChar(300)
  familyMemberId String? @map("family_member_id") @db.Uuid

  /// `{ weekdays: number[], time: 'HH:mm', everyNWeeks: 1 | 2 | 4 }`, validated
  /// by `ritualRecurrenceSchema` at the boundary. JSON rather than columns
  /// because the three fields are only ever read together, by one engine.
  recurrence Json

  idealMinutes     Int     @map("ideal_minutes")
  minimumMinutes   Int     @map("minimum_minutes")
  fallbackBehavior String? @map("fallback_behavior") @db.VarChar(200)

  active Boolean @default(true)

  /// The last local date the materializer has covered. Date-only: it is a
  /// horizon in the user's calendar, not an instant.
  lastMaterializedThrough DateTime? @map("last_materialized_through") @db.Date

  /// The routine that shows this ritual on the Path, when the user linked the
  /// ritual to an outcome. SetNull: the ritual outlives the plan version.
  routineId String? @map("routine_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user         User          @relation("UserRituals", fields: [userId], references: [id], onDelete: Cascade)
  familyMember FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  routine      Routine?      @relation(fields: [routineId], references: [id], onDelete: SetNull)
  commitments  Commitment[]

  @@index([userId, active])
  @@map("rituals")
}

// =============================================================================
// Coaching notifications — the decision log and push endpoints (issue #49, E12)
// =============================================================================
//
// WHY A SECOND TABLE NEXT TO `notification_deliveries`.
//
// `notification_deliveries` answers "did a channel accept this message?" — an
// operational question about a transport. E12 asks four different questions
// that no delivery row can answer:
//
//   1. WAS IT SENT AT ALL, AND IF NOT, WHY? A message the policy suppressed
//      never reaches a channel, so it produces no delivery row. "We stayed
//      quiet because you were in quiet hours" is the single most important
//      fact this epic records, and it is invisible in the delivery table.
//   2. WHAT DID THE USER DO WITH IT? `notifications.readAt` records an inbox
//      click and nothing else — not "moved it", not "skipped", not "dismissed
//      from the OS shade with no session".
//   3. WHICH COMMITMENT DID IT CONCERN? Required by the per-commitment cap
//      (PRD §61) and by the independence metric (PRD §65), and a delivery row
//      has no product foreign keys by design.
//   4. HAVE WE ALREADY DECIDED ABOUT THIS CANDIDATE? The scheduler re-scans
//      the same window every few minutes; without a unique decision key it
//      would re-send on every tick.
//
// One table answers all four because they are one timeline: a SENT row and the
// OPENED/ACTIONED/DISMISSED rows that point back at it through
// `sentInteractionId`. Splitting sends from responses would mean joining two
// tables for every single metric in E12-06.

enum NotificationInteractionKind {
  /// The policy said yes and the message went out.
  SENT
  /// The user brought the message up (bell click, push click, deep link).
  OPENED
  /// The user did the thing the message asked for.
  ACTIONED
  /// The user explicitly got rid of it. Distinct from "ignored", which is the
  /// absence of any response and is computed, not stored.
  DISMISSED
  /// The policy said no. `suppressReason` says which rule fired.
  SUPPRESSED

  @@map("notification_interaction_kind")
}

enum NotificationActionKind {
  START
  IN
  MOVE
  SHORT
  SKIP

  @@map("notification_action_kind")
}

enum NotificationSuppressReason {
  QUIET_HOURS
  DAILY_CAP
  WEEKLY_CAP
  PER_COMMITMENT_MAX
  SKIPPED
  MUTED
  DOMAIN_PAUSED
  FATIGUE
  ALREADY_DONE

  @@map("notification_suppress_reason")
}

model NotificationInteraction {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Plain string, NOT a foreign key — the same reasoning spelled out on
  /// `Notification.eventKey`: events live in code and persisted rows outlive
  /// their definitions.
  eventKey String @map("event_key")

  kind NotificationInteractionKind

  commitmentId   String? @map("commitment_id") @db.Uuid
  /// The inbox row, once the browser channel has written one.
  notificationId String? @map("notification_id") @db.Uuid
  /// The `notification_deliveries` row, once a channel has queued one.
  deliveryId     String? @map("delivery_id") @db.Uuid

  /// OPENED/ACTIONED/DISMISSED point back at the SENT row they answer.
  sentInteractionId String? @map("sent_interaction_id") @db.Uuid

  action         NotificationActionKind?
  suppressReason NotificationSuppressReason? @map("suppress_reason")

  /// Scheduler idempotency. A PLAIN STRING chosen by the caller — no structure
  /// is parsed out of it, so the engine can change how it identifies a
  /// candidate without a migration. NULL on responses, which is what makes the
  /// unique index below harmless for them (NULLs never conflict in Postgres).
  dedupeKey String? @map("dedupe_key")

  /// `{ leadMinutes?, copySource?: 'ai' | 'template', category?: 'N1'…'N9', localDate? }`
  meta Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user            User                      @relation("UserNotificationInteractions", fields: [userId], references: [id], onDelete: Cascade)
  commitment      Commitment?               @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  notification    Notification?             @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  delivery        NotificationDelivery?     @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  sentInteraction NotificationInteraction?  @relation("SentInteraction", fields: [sentInteractionId], references: [id], onDelete: SetNull)
  responses       NotificationInteraction[] @relation("SentInteraction")

  /// One decision per candidate. NULL dedupe keys never conflict, so responses
  /// are unconstrained by it.
  @@unique([userId, eventKey, dedupeKey])
  /// Caps and fatigue: SENT rows inside a local day or week.
  @@index([userId, kind, createdAt(sort: Desc)])
  /// Per-commitment max, and the independence metric.
  @@index([userId, commitmentId, kind])
  @@index([sentInteractionId])
  @@map("notification_interactions")
}

model PushSubscription {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// The push service URL. UNIQUE ACROSS USERS, not per user: a browser
  /// profile handed to another account re-registers the same endpoint, and two
  /// rows would mean the new owner's messages reach the old one's device.
  endpoint String @unique

  /// `{ p256dh, auth }` — the subscription's own encryption keys, validated by
  /// `push-subscription.schema.ts` at the boundary. Not secrets of ours; they
  /// are useless without the endpoint they belong to.
  keys Json

  userAgent String? @map("user_agent")

  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  user User @relation("UserPushSubscriptions", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// =============================================================================
// The AI coach and what it is allowed to remember (epic E06, issue #61)
// =============================================================================
//
// Four product tables, and the line between them and `ai_invocations` is the
// point of the whole group. `ai_invocations` is TELEMETRY: what we asked a
// model, what it cost, whether it validated, prunable at will. Everything
// below is PRODUCT STATE the user owns and can inspect — a conversation they
// can reread, a proposal they accepted, a sentence about themselves they can
// delete (PRD §17 Tier 3/Tier 4, §85). Losing a telemetry row must never lose
// any of it, which is why every `invocationId` here is a plain String and not
// a foreign key.
//
// The second rule the group encodes: the model never mutates a plan. A
// `PlanChangeProposal` is a PROPOSAL until a human decides, and applying one
// produces a new `PlanVersion` through the ordinary E02 versioning path
// (PRD §15, VISION §19/§20). `appliedPlanVersionId` records which version the
// acceptance produced; it can never be the mechanism that creates it.

enum CoachMessageRole {
  USER
  COACH
  SYSTEM
}

/// Where a plan-change proposal came from. E06 only ever writes COACH; the
/// other three exist from day one so E09/E10/E11 land without a migration.
enum ProposalSourceKind {
  COACH
  WEEKLY_REVIEW
  WORKOUT
  PATTERN
}

enum ProposalStatus {
  PROPOSED
  ACCEPTED
  EDITED
  REJECTED
  EXPIRED
}

enum MemoryInsightCategory {
  IDENTITY
  WORK
  FAMILY
  HEALTH
  COACHING_PREFERENCE
  NOTIFICATION_PREFERENCE
  PATTERN
}

/// Who wrote the sentence. USER insights are never proposed, never expire on
/// their own, and are `userConfirmed` by construction.
enum MemoryInsightSource {
  AI
  USER
}

/// The recurring frictions the product names (PRD §10.11). `OTHER` is the
/// escape hatch so a detector never has to invent an enum member.
enum ObstacleType {
  EVENING_WORKOUT_UNRELIABLE
  AMBIGUOUS_WORK_TASK
  FAMILY_PLAN_COLLIDES_WITH_WORK
  OVERCOMMITMENT
  PERFECTIONISM
  LOW_ENERGY_WINDOW
  OTHER
}

/// One coach thread. Deliberately thin: the conversation is an ordering
/// device, not a place to hang state — everything the coach reasons from is
/// assembled fresh from product tables on each turn (PRD §14.1).
model CoachConversation {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// Short human label, derived from the first user message. Nullable because
  /// a conversation exists the moment it is opened, before anything is said.
  title String?

  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  /// Denormalised so the list query sorts without touching `coach_messages`.
  lastMessageAt DateTime @default(now()) @map("last_message_at") @db.Timestamptz

  user     User           @relation("UserCoachConversations", fields: [userId], references: [id], onDelete: Cascade)
  messages CoachMessage[]

  @@index([userId, lastMessageAt(sort: Desc)])
  @@map("coach_conversations")
}

model CoachMessage {
  id             String @id @default(uuid()) @db.Uuid
  conversationId String @map("conversation_id") @db.Uuid

  role    CoachMessageRole
  content String           @db.Text

  /// The validated `coach_reply` contract (E06-03), plus `proposal.proposalId`
  /// when the turn created one. Null for USER and SYSTEM rows, and null for a
  /// template fallback reply — a fallback is deliberately indistinguishable
  /// from "no structured contract", because there was no model output.
  structured Json?

  /// Ids of `MediaAttachment` rows. NOT a foreign key and NOT a relation:
  /// deleting an attachment must leave the message the user sent intact.
  attachmentIds String[] @default([]) @map("attachment_ids")

  /// The `ai_invocations` row this reply came from. Plain String on purpose —
  /// see the block comment above: telemetry is prunable, product state is not.
  invocationId String? @map("invocation_id") @db.Uuid

  /// The E06-06 `SafetyDecision` that governed this turn. Present on COACH
  /// rows; a `redirect` decision is the one case where the row exists and
  /// `invocationId` does not, because no coach model was called at all.
  safetyDecision Json? @map("safety_decision")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  conversation CoachConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  proposals    PlanChangeProposal[] @relation("ProposalSourceMessage")

  @@index([conversationId, createdAt])
  @@map("coach_messages")
}

/// A proposed change to a plan, waiting on a human.
///
/// THE THREE onDelete CHOICES HERE ARE THE WHOLE DESIGN, so they are written
/// down rather than inferred:
///
///   * `user` and `plan` CASCADE. A proposal is meaningless without either,
///     and account deletion must leave no coaching data behind.
///   * `sourceMessage` SET NULL. The proposal is the durable artefact; the
///     message that produced it is conversation. Deleting a thread must not
///     silently erase the record of a plan change the user accepted.
///   * `appliedVersion` SET NULL. A plan version can be deleted; the fact that
///     this proposal was accepted must survive it as history, and a Cascade
///     here would quietly rewrite the audit trail.
model PlanChangeProposal {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  planId String @map("plan_id") @db.Uuid

  sourceKind      ProposalSourceKind @map("source_kind")
  sourceMessageId String?            @map("source_message_id") @db.Uuid

  /// One sentence the user reads before the diff. Bounded by Zod at the
  /// boundary (≤300), not by the column: the length is a copy rule.
  summary String

  /// Array of `PlanChange` (E06-04's schema). The diff itself.
  changes Json

  /// Set the first time an edit rewrites `changes`, so "what the coach
  /// actually proposed" is never lost behind what the user made of it.
  originalChanges Json? @map("original_changes")

  status ProposalStatus @default(PROPOSED)

  appliedPlanVersionId String? @map("applied_plan_version_id") @db.Uuid
  invocationId         String? @map("invocation_id") @db.Uuid

  /// Creator sets `now + 7 days`. Expiry is evaluated lazily on read (E06-04);
  /// there is no sweeper, because a stale row nobody reads costs nothing.
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  editedAt  DateTime? @map("edited_at") @db.Timestamptz
  decidedAt DateTime? @map("decided_at") @db.Timestamptz

  /// Why the user said no, in their words. Kept for the coach to read back.
  decisionReason String? @map("decision_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user           User          @relation("UserPlanChangeProposals", fields: [userId], references: [id], onDelete: Cascade)
  plan           Plan          @relation("PlanChangeProposals", fields: [planId], references: [id], onDelete: Cascade)
  sourceMessage  CoachMessage? @relation("ProposalSourceMessage", fields: [sourceMessageId], references: [id], onDelete: SetNull)
  appliedVersion PlanVersion?  @relation("ProposalAppliedVersion", fields: [appliedPlanVersionId], references: [id], onDelete: SetNull)

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([planId])
  @@map("plan_change_proposals")
}

/// A durable sentence about the user that the coach may reuse (PRD §17 Tier 3,
/// §85). Two booleans, and they are not the same question: `userConfirmed` is
/// "the user says this is true", `doNotUse` is "the user says never bring this
/// up". An insight can be both true and forbidden, so neither can be modelled
/// as the other's negation.
model MemoryInsight {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  category  MemoryInsightCategory
  statement String

  evidenceCount Int   @default(0) @map("evidence_count")
  /// Float, not Decimal: nothing sums it and Zod clamps it to [0,1].
  confidence    Float

  userConfirmed Boolean @default(false) @map("user_confirmed")
  doNotUse      Boolean @default(false) @map("do_not_use")

  /// Null means "until the user removes it". A past value means the assembler
  /// skips it without deleting it, so the user can still see it and re-confirm.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz

  source       MemoryInsightSource
  invocationId String?             @map("invocation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation("UserMemoryInsights", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([userId, doNotUse, userConfirmed])
  @@map("memory_insights")
}

/// A recurring friction (PRD §10.11). E06 creates the table and lets the coach
/// read it; nothing detects obstacles until E07-03.
model Obstacle {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  type        ObstacleType
  description String
  domain      Domain

  observedCount  Int      @default(1) @map("observed_count")
  confidence     Float
  lastObservedAt DateTime @default(now()) @map("last_observed_at") @db.Timestamptz

  /// PRD §10.11 `intervention_history`: E07-03 appends `{level, at}` entries.
  interventionHistory Json @default("[]") @map("intervention_history")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation("UserObstacles", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, domain, lastObservedAt(sort: Desc)])
  @@map("obstacles")
}

// =============================================================================
// Weekly review & planning (epic E10)
// =============================================================================
//
// TWO ROWS PER WEEK, AND THE WEEK IS A STRING.
//
// `weekStart` is the user's local Monday as 'YYYY-MM-DD' text, not `@db.Date`.
// A date column round-trips through Prisma as UTC midnight, so a user west of
// Greenwich reads back the Sunday — the same trap `daily_check_ins.date_local`
// (E05-03) avoided the same way. Weeks are Monday-start everywhere in this
// product; `localWeekBounds` and `docs/specs/family-domain.md` already fixed
// that and a second convention would make "this week" two questions.
//
// A review is what happened; a plan is what is intended next. They are separate
// rows because they have separate lifecycles — a review can be READY forever
// with nobody planning anything — and separate unique keys on `(user, week)`,
// so a plan for week N sits beside the review of week N-1 it came from.
// =============================================================================

enum WeeklyReviewStatus {
  GENERATING
  READY
  APPROVED
  SKIPPED
}

enum WeeklyPlanStatus {
  DRAFT
  APPROVED
}

/// One Monday-start week, compared against its plan (PRD §14.6, §51).
///
/// `aggregates` is deterministic — computed from commitments, evidence and
/// reflections with no model involved — and `aiSummary` is the coach's reading
/// of it, which may be `source: 'template'` when the provider is down (PRD
/// §120). Keeping them in two columns is what makes that fallback invisible to
/// every consumer of the numbers.
model WeeklyReview {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  /// The user's local Monday, 'YYYY-MM-DD'. See the header for why it is text.
  weekStart String @map("week_start") @db.VarChar(10)

  status WeeklyReviewStatus @default(GENERATING)

  /// `weekAggregatesSchema` (weekly.schema.ts). Validated at the boundary.
  aggregates Json  @default("{}")
  /// `weeklyReviewSummarySchema`. Null until a generation finishes.
  aiSummary  Json? @map("ai_summary")

  /// `PlanChangeProposal` ids, DELIBERATELY WITHOUT AN FK. E06-04 expires
  /// proposals lazily and they may be pruned; a review is a historical record
  /// and must survive that. Readers skip ids that no longer resolve.
  proposalIds String[] @default([]) @map("proposal_ids")

  /// `ai_invocations` id. A plain string for the same reason: telemetry is
  /// prunable and a review must not be.
  invocationId String? @map("invocation_id")

  generatedAt DateTime? @map("generated_at") @db.Timestamptz
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user  User         @relation("UserWeeklyReviews", fields: [userId], references: [id], onDelete: Cascade)
  plans WeeklyPlan[] @relation("WeeklyPlanReview")

  @@unique([userId, weekStart])
  @@index([userId, status])
  @@map("weekly_reviews")
}

/// The coming week, before it is committed to (PRD §50).
///
/// `reviewId` is SetNull rather than Cascade: deleting a review must not delete
/// the week somebody already approved off the back of it.
model WeeklyPlan {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  weekStart String  @map("week_start") @db.VarChar(10)
  reviewId  String? @map("review_id") @db.Uuid

  /// One sentence, ≤ 200 chars (Zod). PRD §50 step 3 — ONE primary focus.
  primaryFocus String? @map("primary_focus")

  /// `weeklyPlanConstraintsSchema` — travel days, fixed events, notes.
  constraints Json  @default("{}")
  /// `weeklyDomainModesSchema` — the posture the user intends for next week.
  domainModes Json  @default("{}") @map("domain_modes")
  /// `weeklyPlanProposalSchema` (E10-03) — the materialised items, the load
  /// summary and its warnings. Cleared whenever the inputs change.
  proposal    Json?

  status     WeeklyPlanStatus @default(DRAFT)
  approvedAt DateTime?        @map("approved_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user   User          @relation("UserWeeklyPlans", fields: [userId], references: [id], onDelete: Cascade)
  review WeeklyReview? @relation("WeeklyPlanReview", fields: [reviewId], references: [id], onDelete: SetNull)

  @@unique([userId, weekStart])
  @@index([userId, status])
  @@map("weekly_plans")
}

// =============================================================================
// The Health domain: workout programs, sessions and body weight (epic E09)
// =============================================================================
//
// PRD §38 asks for workout plans that are STRUCTURAL rather than conversational,
// and that is the whole reason these tables exist. A program the coach described
// in a chat message cannot schedule itself onto Today, cannot show "last time"
// on the next session, and cannot be adapted when the user keeps skipping it.
//
// Three shapes carry that:
//
//   1. A PROGRAM owns TEMPLATES, and a template is a WORKOUT AT ONE SIZE.
//      "Upper A" exists three times — FULL, SHORT and MINIMUM — rather than once
//      with a set of modifiers, because the runner has to render a concrete
//      exercise list the moment a user taps "use the short version" (PRD §44,
//      VISION §15). Deriving that list at read time would be a second, quieter
//      implementation of programming.
//   2. A SESSION is what actually happened, and it is NOT the commitment.
//      A user can run the same template twice in a day, or run one with no
//      commitment at all; `commitment_id` is therefore nullable and SetNull.
//   3. A SET LOG carries a CLIENT-MINTED `client_id`. PRD §121 requires the
//      runner to work with intermittent connectivity, which means the phone
//      replays a queue it is not sure was accepted. The unique index on that
//      column is what makes the replay idempotent — not a transaction, and not
//      client-side bookkeeping.

/// What a movement needs. An array rather than a single value: a Bulgarian
/// split squat wants a bench AND dumbbells, and the builder filters the catalog
/// by what the user actually has.
enum Equipment {
  BODYWEIGHT
  DUMBBELL
  BARBELL
  MACHINE
  CABLE
  KETTLEBELL
  BAND
  BENCH
}

/// PRD §39's movement taxonomy. `ACCESSORY` is a deliberate tenth value so that
/// VISION §14's Upper A example (triceps pressdown, dumbbell curl) can be seeded
/// without mislabelling an isolation movement as a press or a pull.
enum MovementPattern {
  PUSH_H
  PUSH_V
  PULL_H
  PULL_V
  SQUAT
  HINGE
  LUNGE
  CARRY
  CORE
  ACCESSORY
}

/// PRD §42 is explicit that progression stays conservative and deterministic.
/// The enum has one member on purpose: it is a place for a second scheme to
/// land, not an invitation to add one.
enum ProgressionMethod {
  DOUBLE_PROGRESSION
}

enum WorkoutProgramStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// The three sizes of one workout (PRD §44). Mirrors `CommitmentVersion`, but
/// they are not the same enum: a commitment's version is a label on an
/// intention, a template's variant is a different row of exercises.
enum WorkoutVariant {
  FULL
  SHORT
  MINIMUM
}

enum WorkoutSessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// PRD §45. `SHARP_PAIN` is a safety signal, never a programming input: it stops
/// the exercise and shows professional-care copy. It is deliberately not a
/// numeric scale — a number invites the software to reason about it.
enum Discomfort {
  NONE
  MILD
  SHARP_PAIN
}

/// The movement catalog (PRD §39).
///
/// One table for shared rows and per-user rows. `scope` is `'catalog'` for the
/// seeded 44 and the owning user's id for anything the builder had to invent, so
/// `@@unique([scope, nameKey])` lets two users each have their own "DB Bench
/// Press" while the catalog keeps exactly one.
model Exercise {
  id String @id @default(uuid()) @db.Uuid

  name    String
  /// `name.trim().toLowerCase()` with runs of whitespace collapsed, computed by
  /// the service and by the seed. Not a generated column: a generated column
  /// would make the migration depend on the exact Postgres version's notion of
  /// immutability, for a value two callers already produce.
  nameKey String @map("name_key")
  /// `'catalog'`, or the id of the user who owns this custom row.
  scope   String @default("catalog")

  equipment            Equipment[]
  movementPattern      MovementPattern @map("movement_pattern")
  instructions         String          @db.Text
  /// From the fixed vocabulary in `workout-program-rules.ts`. What the safety
  /// rules intersect a user's stated limitations against.
  contraindicationTags String[]        @map("contraindication_tags")
  /// What this movement can be swapped for (PRD §37). Substitution is a lookup,
  /// not a model call.
  substitutionGroup    String          @map("substitution_group")

  isCustom        Boolean @default(false) @map("is_custom")
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  createdBy         User?                     @relation("UserCustomExercises", fields: [createdByUserId], references: [id], onDelete: SetNull)
  templateExercises WorkoutTemplateExercise[]
  setLogs           SetLog[]

  @@unique([scope, nameKey])
  @@index([substitutionGroup])
  @@map("exercises")
}

/// A structured workout program (PRD §37, §38; VISION §52).
///
/// `planId` is null until the user approves: PRD §15 says AI output becomes a
/// plan only when a human says so, and a DRAFT program that already pointed at a
/// plan would be exactly the half-applied state that rule exists to prevent.
model WorkoutProgram {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  name            String
  durationWeeks   Int    @map("duration_weeks")
  /// `[{ weekday: 0-6, templateId }]`, typed by Zod at the boundary.
  weeklyStructure Json   @map("weekly_structure")

  progressionMethod ProgressionMethod    @default(DOUBLE_PROGRESSION) @map("progression_method")
  status            WorkoutProgramStatus @default(DRAFT)

  /// The E02 plan of the user's Health outcome. Set at approve, SetNull after.
  planId String? @map("plan_id") @db.Uuid

  /// The validated builder request. Kept so a regenerate can start from what the
  /// user actually asked for; it holds free-text limitations and is never logged.
  generationInput Json?   @map("generation_input")
  rationale       String? @db.Text
  /// `[{ exerciseId, alternativeExerciseIds[] }]`.
  substitutions   Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user      User              @relation("UserWorkoutPrograms", fields: [userId], references: [id], onDelete: Cascade)
  plan      Plan?             @relation(fields: [planId], references: [id], onDelete: SetNull)
  templates WorkoutTemplate[]

  @@index([userId, status])
  @@map("workout_programs")
}

/// One workout at one size (PRD §40, §44).
///
/// `routineId` is 1:1 and exists only on FULL templates: it is the join that
/// lets an E06 plan-change proposal, whose diffs target routines, reach a
/// workout template (E09-05). Without it the adaptation detector would have to
/// invent a second targeting vocabulary.
model WorkoutTemplate {
  id        String @id @default(uuid()) @db.Uuid
  programId String @map("program_id") @db.Uuid

  name          String
  variant       WorkoutVariant
  targetMinutes Int            @map("target_minutes")

  /// SHORT and MINIMUM point at their FULL sibling.
  fallbackOfTemplateId String? @map("fallback_of_template_id") @db.Uuid
  routineId            String? @unique @map("routine_id") @db.Uuid

  program    WorkoutProgram    @relation(fields: [programId], references: [id], onDelete: Cascade)
  routine    Routine?          @relation(fields: [routineId], references: [id], onDelete: SetNull)
  fallbackOf WorkoutTemplate?  @relation("TemplateFallbacks", fields: [fallbackOfTemplateId], references: [id], onDelete: Cascade)
  fallbacks  WorkoutTemplate[] @relation("TemplateFallbacks")

  exercises   WorkoutTemplateExercise[]
  sessions    WorkoutSession[]
  commitments Commitment[]

  @@unique([programId, name, variant])
  @@map("workout_templates")
}

/// A prescribed movement inside a template: sets, a rep RANGE and rest.
///
/// The range is two columns rather than a string because double progression
/// (PRD §42) is arithmetic over its ends — "all sets at repMax" is the entire
/// trigger for adding weight.
model WorkoutTemplateExercise {
  id         String @id @default(uuid()) @db.Uuid
  templateId String @map("template_id") @db.Uuid
  exerciseId String @map("exercise_id") @db.Uuid

  order       Int
  sets        Int
  repMin      Int     @map("rep_min")
  repMax      Int     @map("rep_max")
  restSeconds Int     @map("rest_seconds")
  notes       String?

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// Restrict, not Cascade: deleting a catalog movement that somebody's program
  /// prescribes must fail loudly rather than quietly empty their workout.
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([templateId, order])
  @@map("workout_template_exercises")
}

/// One run of one template (PRD §41; VISION §52).
model WorkoutSession {
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  commitmentId String? @unique @map("commitment_id") @db.Uuid
  templateId   String  @map("template_id") @db.Uuid

  /// Which size was actually run. Changed mid-session when the user drops to the
  /// short version, which is why it lives here and not only on the template.
  variant WorkoutVariant

  startedAt  DateTime  @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz

  status         WorkoutSessionStatus @default(IN_PROGRESS)
  /// True once any set was logged with MILD or SHARP_PAIN. A flag rather than a
  /// score: PRD §45's response is to stop and suggest professional evaluation,
  /// and nothing in the product should be tempted to average it.
  discomfortFlag Boolean              @default(false) @map("discomfort_flag")

  user       User            @relation("UserWorkoutSessions", fields: [userId], references: [id], onDelete: Cascade)
  commitment Commitment?     @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  template   WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  setLogs    SetLog[]

  @@index([userId, templateId, status, startedAt])
  @@map("workout_sessions")
}

/// One set, as it was actually performed (PRD §41).
///
/// `clientId` is minted by the phone, not the server. It is the whole of the
/// offline story: the runner queues sets it could not send, replays the queue on
/// reconnect, and this unique index turns a duplicate replay into a P2002 the
/// API maps to "already saved" instead of a second set.
model SetLog {
  id         String @id @default(uuid()) @db.Uuid
  sessionId  String @map("session_id") @db.Uuid
  exerciseId String @map("exercise_id") @db.Uuid

  setNumber  Int        @map("set_number")
  weightKg   Decimal?   @map("weight_kg") @db.Decimal(6, 2)
  reps       Int
  /// 1-10, validated at the API boundary. Optional because RPE is a skill.
  rpe        Int?
  discomfort Discomfort @default(NONE)

  loggedAt DateTime @map("logged_at") @db.Timestamptz
  clientId String   @unique @map("client_id")

  session  WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exercise Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([sessionId, exerciseId, setNumber])
  @@map("set_logs")
}

/// An optional body-weight entry (PRD §47).
///
/// `dateLocal` is text in the user's own timezone, exactly like
/// `daily_check_ins.date_local`: "the day I weighed myself" is a calendar fact,
/// and a timestamp would make it depend on where the user was standing.
model BodyWeightLog {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  dateLocal String  @map("date_local") @db.VarChar(10)
  weightKg  Decimal @map("weight_kg") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation("UserBodyWeightLogs", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dateLocal])
  @@map("body_weight_logs")
}
